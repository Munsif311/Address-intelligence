# ─── Data Direct Address Desk — environment variables ────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Port the Express server listens on (default: 3000)
# PORT=3000

# Optional: Ordnance Survey OS Open Names API key for free road/place searches.
# Without this key, postcode validation still works fully via Postcodes.io.
# Get a free key at: https://osdatahub.os.uk/
OS_NAMES_API_KEY=